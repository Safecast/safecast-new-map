{
  "model": "gpt",
  "display_name": "GPT-4 / ChatGPT",
  "capabilities": ["tool_use", "json_mode", "function_calling"],
  "system_prompt": "You are an AI assistant with access to the Safecast radiation monitoring database. Use tools to retrieve data. Provide concise, factual responses.",
  "tools": {
    "query_radiation": {
      "description": "Find radiation measurements near a location. Call sensor_current afterward to check for real-time sensors.",
      "examples": [
        {
          "user_query": "Radiation level near Fukushima?",
          "tool_call": {
            "name": "query_radiation",
            "arguments": {
              "lat": 37.4267,
              "lon": 140.5367,
              "radius_m": 50000,
              "limit": 25
            }
          }
        }
      ],
      "output_hints": "Use markdown table. Include map links: [lat°N, lon°E](https://simplemap.safecast.org/?lat=LAT&lon=LON&zoom=15). Distinguish CPM vs µSv/h.",
      "formatting_rules": {
        "table_format": "markdown",
        "map_links": "required"
      }
    },
    "search_area": {
      "description": "Find radiation measurements in a bounding box.",
      "examples": [
        {
          "user_query": "Tokyo area radiation",
          "tool_call": {
            "name": "search_area",
            "arguments": {
              "min_lat": 35.5,
              "max_lat": 35.8,
              "min_lon": 139.5,
              "max_lon": 139.9,
              "limit": 50
            }
          }
        }
      ],
      "output_hints": "Summarize by area. Use map links."
    },
    "list_tracks": {
      "description": "List available measurement tracks.",
      "examples": [
        {
          "user_query": "Tracks from 2024?",
          "tool_call": {
            "name": "list_tracks",
            "arguments": {
              "year": 2024,
              "limit": 20
            }
          }
        }
      ],
      "output_hints": "Include track ID, date range, marker count."
    },
    "get_track": {
      "description": "Get all measurements from a track.",
      "examples": [
        {
          "user_query": "Track 2024-01-15-fukushima data",
          "tool_call": {
            "name": "get_track",
            "arguments": {
              "track_id": "2024-01-15-fukushima"
            }
          }
        }
      ],
      "output_hints": "Table with dose rates, locations, timestamps."
    },
    "device_history": {
      "description": "Get device measurement history.",
      "examples": [
        {
          "user_query": "SC-12345 last 7 days",
          "tool_call": {
            "name": "device_history",
            "arguments": {
              "device_id": "SC-12345",
              "days": 7
            }
          }
        }
      ],
      "output_hints": "Time series format."
    },
    "get_spectrum": {
      "description": "Get gamma spectrum for a marker.",
      "examples": [
        {
          "user_query": "Spectrum for marker 12345",
          "tool_call": {
            "name": "get_spectrum",
            "arguments": {
              "marker_id": 12345
            }
          }
        }
      ],
      "output_hints": "Include device, energy range, channels."
    },
    "list_spectra": {
      "description": "Browse gamma spectroscopy records.",
      "examples": [
        {
          "user_query": "Available spectra?",
          "tool_call": {
            "name": "list_spectra",
            "arguments": {
              "limit": 20
            }
          }
        }
      ],
      "output_hints": "List marker IDs, devices, dates."
    },
    "radiation_info": {
      "description": "Get radiation reference info.",
      "examples": [
        {
          "user_query": "Is 0.5 µSv/h dangerous?",
          "tool_call": {
            "name": "radiation_info",
            "arguments": {
              "topic": "safety_levels"
            }
          }
        }
      ],
      "output_hints": "Clear reference content.",
      "topics": ["units", "dose_rates", "safety_levels", "detectors", "background_levels", "isotopes"]
    },
    "list_sensors": {
      "description": "List real-time sensors.",
      "examples": [
        {
          "user_query": "Sensors in Japan?",
          "tool_call": {
            "name": "list_sensors",
            "arguments": {
              "country": "JP",
              "limit": 50
            }
          }
        }
      ],
      "output_hints": "Include status, location, last reading."
    },
    "sensor_current": {
      "description": "Get current real-time sensor readings. Required after query_radiation.",
      "examples": [
        {
          "user_query": "Current Tokyo readings?",
          "tool_call": {
            "name": "sensor_current",
            "arguments": {
              "min_lat": 35.5,
              "max_lat": 35.8,
              "min_lon": 139.5,
              "max_lon": 139.9
            }
          }
        }
      ],
      "output_hints": "Latest readings with timestamps."
    },
    "sensor_history": {
      "description": "Get sensor historical data.",
      "examples": [
        {
          "user_query": "SC-98765 last 24h",
          "tool_call": {
            "name": "sensor_history",
            "arguments": {
              "device_id": "SC-98765",
              "hours": 24
            }
          }
        }
      ],
      "output_hints": "Time series format."
    },
    "query_analytics": {
      "description": "Query DuckDB analytics.",
      "examples": [
        {
          "user_query": "Fukushima average?",
          "tool_call": {
            "name": "query_analytics",
            "arguments": {
              "query": "average_by_prefecture"
            }
          }
        }
      ],
      "output_hints": "Summarize statistics."
    },
    "radiation_stats": {
      "description": "Get database statistics.",
      "examples": [
        {
          "user_query": "Database size?",
          "tool_call": {
            "name": "radiation_stats",
            "arguments": {}
          }
        }
      ],
      "output_hints": "Key metrics."
    },
    "query_extreme_readings": {
      "description": "Find extreme radiation readings.",
      "examples": [
        {
          "user_query": "Highest readings?",
          "tool_call": {
            "name": "query_extreme_readings",
            "arguments": {
              "type": "highest",
              "limit": 10
            }
          }
        }
      ],
      "output_hints": "Include context."
    },
    "top_uploaders": {
      "description": "Get top contributor stats.",
      "examples": [
        {
          "user_query": "Top contributors?",
          "tool_call": {
            "name": "top_uploaders",
            "arguments": {
              "limit": 10
            }
          }
        }
      ],
      "output_hints": "List with counts."
    },
    "search_tracks_by_location": {
      "description": "Find tracks near a location.",
      "examples": [
        {
          "user_query": "Tracks near Chernobyl?",
          "tool_call": {
            "name": "search_tracks_by_location",
            "arguments": {
              "lat": 51.39,
              "lon": 30.10,
              "radius_km": 50
            }
          }
        }
      ],
      "output_hints": "List with dates."
    },
    "db_info": {
      "description": "Get database info.",
      "examples": [
        {
          "user_query": "Available data?",
          "tool_call": {
            "name": "db_info",
            "arguments": {}
          }
        }
      ],
      "output_hints": "Summarize data types."
    },
    "query_duckdb_logs": {
      "description": "Query DuckDB logs.",
      "examples": [
        {
          "user_query": "Recent queries?",
          "tool_call": {
            "name": "query_duckdb_logs",
            "arguments": {
              "limit": 10
            }
          }
        }
      ],
      "output_hints": "Log entries with timestamps."
    }
  },
  "global_formatting_rules": {
    "tone": "Concise, factual",
    "coordinates": "Map links required",
    "tables": "Markdown for measurements",
    "units": "Specify units"
  }
}
